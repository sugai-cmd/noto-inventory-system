# ポート番号
PORT=3000

# 待ち受けアドレス
#   0.0.0.0   = 他の端末からも接続できる（既定。複数PCで使う場合はこちら）
#   127.0.0.1 = そのMacの中からのみ
HOST=0.0.0.0

# データベースファイルの場所
DB_PATH=./db/database.sqlite

# HTTPSで直接待ち受ける場合のみ設定する（両方セットで指定）。
# Tailscale経由で使う場合は tailscale serve がHTTPSを引き受けるため、
# ここは設定不要です。
# TLS_KEY_PATH=./certs/server.key
# TLS_CERT_PATH=./certs/server.crt

# 週次報告の書き出し先（Googleスプレッドシートに置いたApps Script）。
# 手順は docs/WEEKLY-REPORT.md。合言葉はここ（.env）とスクリプト プロパティにだけ置く。
# REPORT_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxx/exec
# REPORT_WEBHOOK_SECRET=

# FAX発注書の自動取込（docs/FAX-AUTO-IMPORT.md）
# 共有ドライブのFAXフォルダ（Googleドライブ パソコン版で同期された場所）
# FAX_INBOX_DIR=/Users/YOUR_NAME/Library/CloudStorage/GoogleDrive-sugai@naorai.co/共有ドライブ/（共有ドライブ名）/FAX

# COREZO（金沢楽座）注文メールの自動取込（docs/COREZO-ORDER-IMPORT.md）
# 共有ドライブのCOREZOフォルダ（Googleドライブ パソコン版で同期された場所）
# COREZO_INBOX_DIR=/Users/YOUR_NAME/Library/CloudStorage/GoogleDrive-sugai@naorai.co/共有ドライブ/（共有ドライブ名）/COREZO

# Slack通知（ボットからDM。SLACK_CHANNEL は自分のメンバーID U… かチャンネルID）
# SLACK_BOT_TOKEN=xoxb-
# SLACK_CHANNEL=
# ボットの代わりにIncoming Webhookを使う場合
# SLACK_WEBHOOK_URL=

# 送り状・納品書の自動登録（docs/SHIP-DOCS-UPLOAD.md）。chmod 600 .env を推奨
# WEBYUPACK_ID=
# WEBYUPACK_PASSWORD=
# MF_EMAIL=
# MF_PASSWORD=
# MF_OFFICE_NAME=
# 対象の得意先を直接指定する場合（既定はカナカン・COREZOを名前で判定）
# SHIP_DOCS_CUSTOMER_IDS=
